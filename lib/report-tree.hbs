<style>

/* Remove default bullets */
#doctor ul {
    list-style-type: none;
}

#doctor #pagesForReview {
    list-style-type: disc;
    font-size: 1.5em;
}

/* Remove margins and padding from the parent ul */
#doctor #tree {
    background-color: #eee;
    margin: 0.5em;
    padding: 1em;
    font-size: 1.5em;
}

#doctor .tag {
    text-decoration: none;
}

#doctor .tag:hover::after,
#doctor .tag-first::after {
    content: ' ' attr(data-tag);
}

/* Style the caret/arrow */
#doctor .caret {
    cursor: pointer;
    user-select: none; /* Prevent text selection */
}

/* Create the caret/arrow with a unicode, and style it */
#doctor .caret::before {
    content: "\25B6";
    color: black;
    display: inline-block;
    margin-right: 6px;
}

#doctor .doc::before {
    content: "\1F4C4";
    display: inline-block;
    margin-right: 6px;   
}

/* Rotate the caret/arrow icon when clicked on (using JavaScript) */
#doctor .caret-down::before {
    transform: rotate(90deg);
}

/* Hide the nested list */
#doctor .nested {
    display: none;
}

/* Show the nested list when the user clicks on the caret/arrow (with JavaScript) */
#doctor .active {
    display: block;
}

#doctor .prbody {
    background: cornsilk;
    margin: 0.5em;    
    padding: 0.5em;
    font-size: 1.2em;
}
</style>

<div id="doctor">
<p>Generated at {{date}}</p>

<h2>Featured Pages</h2>
<ul id="pagesForReview">
    <li>
        <a href="{{root}}index.html">Start page</a>
    </li>
        {{#if mergePrs}}
    <li>
        <a href="{{root}}{{mergePrs}}">Merged pull requests</a>
    </li>
    {{/if}}
    {{#each pagesForReview}}
    <li> <a href="{{root}}{{$href}}">{{$title}}</a>
        (<a href="{{$githubUrl}}">&#x2691;</a>)</li>
    {{/each}}
</ul>

{{#with pr}}
<h2> GitHub PR <a href="{{url}}">#{{number}}: {{title}}</a>
by {{author.name}} ({{state}} {{updatedAt}}) </h2>
<div class="prbody">
    {{{body}}}
</div>
{{/with}}

<h2>Detailed Report</h2>
From this <a href="{{root}}doctor/antora-playbook.json">antora playbook</a>.

<ul id="tree">
{{#each tree.$children}}
   {{> tree}}
{{/each}}
</ul>


<script>
const togglers = document.getElementsByClassName("caret");

for (var toggler of togglers) {
  toggler.addEventListener("click", function() {
    this.parentElement.querySelector(".nested").classList.toggle("active");
    this.classList.toggle("caret-down");
  });
}
</script>
</div>
