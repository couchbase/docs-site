#!/bin/bash
PREVIEW_VERSION="1.2.1"

set -eo pipefail
ORIG_ARGS=("$@")
echo "🐇 Hello! I'm the Docs Build Rabbit"
echo "version $PREVIEW_VERSION"
echo

info()    { [ -t 1 ] && printf '\033[36m%s\033[0m\n' "$*" || echo "$*"; }
warn()    { [ -t 1 ] && printf '\033[1;31m%s\033[0m\n' "$*" || echo "$*"; }
success() { [ -t 1 ] && printf '\033[32m%s\033[0m\n' "$*" || echo "$*"; }

help() {
    cat <<HELP | less
NAME

    preview - a script to quickly preview docs work


SET UP

Update your docs-site repo, and install the script.

    cd docs-site/
    git checkout master
    git pull

    scripts/preview --init

You will also want to install 'gh' and log in.

    brew install gh
    gh auth login  # follow the instructions

Now, from a content repo (under antora.yml) you can build locally:

    preview

Or remotely:

    preview --remote

The latter will show you the URL to find the workflow:

    https://github.com/couchbase/docs-infra/actions/workflows/preview-deploy.yml


UPDATING

To update the preview script, if your script is recent enough, simply run:

    preview --update

Otherwise, you can update the script manually.

    cd docs-site          # navigate to your docs-site repo
    git checkout master   # ensure you are on the master branch

    git pull
    scripts/preview --init

The script also auto-updates itself (like brew/npm do) if it's more than
7 days old, by running the same --update step above the next time you run
it. Configure the threshold, in days, with:

    export PREVIEW_UPDATE_CHECK_DAYS=14


TROUBLESHOOTING

If you run into issues, you can run the script in debug mode.

    preview --debug

This shows the full build output and writes preview/debug.log. Once it
finishes (or fails), it opens preview/doctor/ in Finder - attach debug.log
and the files below to an email or Slack message to the docs team:

    preview/debug.log
    preview/doctor/tree.html
    preview/doctor/antora-playbook.json

Finder only opens automatically on MacOS.
If you are on Linux, then just find and send those files manually.


DOCUMENTATION

See https://confluence.issues.couchbase.com/wiki/spaces/DOCS/pages/2660597775/preview+script

HELP
}

POSITIONAL_ARGS=()
REMOTE=""
INIT=""
PREVIEW_CONFIG=""
DEBUG=""
UPDATE=""

while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help)
      help
      exit 0
      ;;
    -v|--version)
      # no-op, we have already printed the version
      exit 0
      ;;
    -r|--remote)
      REMOTE="true"
      shift # past argument
      ;;
    --init)
      INIT=true
      shift
      ;;
    -c|--config)
      shift
      PREVIEW_CONFIG=$1
      shift
      ;;
    -u|--update)
      UPDATE=true
      shift
      ;;
    -d|--debug)
      DEBUG=true
      shift
      ;;
    -*|--*)
      echo "Unknown option $1"
      exit 1
      ;;
    *)
      POSITIONAL_ARGS+=("$1") # save positional arg
      shift # past argument
      ;;
  esac
done

DOCS_SITE=$(realpath $0/../..)

# Like brew/npm, check every so often whether this script itself is stale
# and update it automatically - nobody remembers to do it by hand.
# NOTE: $0 is usually /usr/local/bin/preview, a symlink to this file - BSD
# stat (macOS) doesn't dereference symlinks by default and would otherwise
# report the symlink's own (never-changing) creation time forever, not this
# file's actual mtime. -L makes both BSD and GNU stat follow it.
PREVIEW_UPDATE_CHECK_DAYS=${PREVIEW_UPDATE_CHECK_DAYS:-7}
if [ -z "$UPDATE" ] && [ -z "$INIT" ]; then
    MTIME=$( { stat -L -f %m "$0" || stat -L -c %Y "$0"; } 2>/dev/null )
    if [ -n "$MTIME" ]; then
        AGE_DAYS=$(( ( $(date +%s) - MTIME ) / 86400 ))
        if [ "$AGE_DAYS" -ge "$PREVIEW_UPDATE_CHECK_DAYS" ]; then
            warn "🐇 This script is ${AGE_DAYS}d old (>= ${PREVIEW_UPDATE_CHECK_DAYS}d) - we are going to do an update, like brew/npm do..."
            "$0" --update
            exec "$0" "${ORIG_ARGS[@]}"
        fi
    fi
fi

if [ -n "$UPDATE" ]; then
    cd $DOCS_SITE

    echo "🐇 Let's try to update preview, by updating your docs-site checkout"
    git checkout master || ( echo "Failed to checkout master branch"; exit 1 )
    git pull || ( echo "Failed to pull latest changes"; exit 1 )

    echo "🐇 Now let's update the preview script"
    INIT=true
fi

if [ -n "$INIT" ]; then
    DOCS_SITE=$(realpath $0/../..)
    cd $DOCS_SITE

    cp -n antora-playbook.preview.local.yml-example antora-playbook.preview.local.yml \
      || echo "antora-playbook.preview.local.yml already exists"

    echo "🐇 Checking 'preview' command link (you may need to enter your password)"

    which preview || sudo ln -sf $(realpath $0) /usr/local/bin/preview
    which preview >/dev/null || ( echo "Failed to link preview command"; exit 1 )

    # HOMEBREW_NO_ASK: newer brew defaults to an "ask mode" that prompts
    # "Do you want to proceed with the installation? [y/n]" for anything
    # beyond exactly the named formulae - not what we want when this runs
    # unattended from the auto-update check above.
    HOMEBREW_NO_ASK=1 brew install gh jq yq
    gh auth token || gh auth login
    npm ci --allow-git=all

    if [ ! -f ~/.git-credentials ]; then
      scripts/add-credentials
    else
      echo "Git credentials found, let's assume they are good."
      echo "If you get errors cloning private repos, then try running:"
      echo 
      echo "    cd $DOCS_SITE"
      echo "    scripts/add-credentials"
      echo
    fi

    echo "🐇 initialised preview script"
    # git pull may not touch this file's mtime if its content didn't change
    # (e.g. it was already up to date) - touch it anyway so the staleness
    # check above doesn't immediately fire again.
    touch "$DOCS_SITE/scripts/preview"
    exit 0
fi



# define utility function
upfind () {
    WHAT=$1
    DEPTH=${2:-1}
    if [ "$DEPTH" -ge 5 ]; then
        return
    fi
    ls -d $WHAT 2>/dev/null || upfind ../$WHAT $((++DEPTH))
}

ANTORA=$(upfind antora.yml)
if [ -z "$ANTORA" ]; then
    echo Did not find 'antora.yml'.
    echo Run preview from a content repository under startPath!
    exit 1
fi
ANTORA=$(realpath $(dirname $ANTORA))
TOPLEVEL=$(git rev-parse --show-toplevel)

export PREVIEW_REPO=$(gh repo view --json name --jq .name)
export PREVIEW_BRANCH=$(git branch --show-current)
export PREVIEW_START_PATH=.${ANTORA#$TOPLEVEL}
export PREVIEW_CONFIG=${PREVIEW_CONFIG:-$PREVIEW_BRANCH}
export PREVIEW_COMPONENT=$(yq .name $ANTORA/antora.yml 2>/dev/null)

if [ -z "$REMOTE" ]; then
    export PREVIEW_OVERRIDE=${PREVIEW_OVERRIDE:-antora-playbook.preview.local.yml}
fi

info "🐇 Building preview for ${PREVIEW_REPO}@${PREVIEW_BRANCH} -> ${PREVIEW_COMPONENT} (start_path: ${PREVIEW_START_PATH:-.})"
if [ -n "$DEBUG" ]; then
    env | grep ^PREVIEW
fi

assert() {
    GOT=$1
    EXPECTED=$2
    WARNING=$3

    if [ "$GOT" != "$EXPECTED" ]; then
        echo
        warn "WARNING $WARNING"
        warn "Your remote build may not match your local preview."

        if [ -t 1 ]; then
            read -n 1 -s -r -p "$(printf '\033[1;31mPress any key to continue, or Ctrl+C to exit\033[0m')"
        else
            read -n 1 -s -r -p "Press any key to continue, or Ctrl+C to exit"
        fi
        echo
        echo
    fi
}

if [ -n "$REMOTE" ]; then
    assert "$(git status -s -uno)" '' 'You have uncommitted changes.'
    assert "$(git status -s preview/HEAD.yml preview/${PREVIEW_BRANCH}.yml)" '' 'You have uncommitted changes to the preview/ configuration.'
    assert "$(git push --dry-run 2>&1)" 'Everything up-to-date' 'You have unpushed changes.'
    assert "$PREVIEW_BRANCH" "$PREVIEW_CONFIG" "Remote preview doesn't support custom --config, will be ignored"
    assert "$DEBUG" "" "Remote preview doesn't support --debug, will be ignored"

    PR_BASE_OID=$(gh pr view --json baseRefOid -q .baseRefOid 2>/dev/null) || true
    PR_BASE_NAME=$(gh pr view --json baseRefName -q .baseRefName 2>/dev/null) || true
    PR_NUMBER=$(gh pr view --json number -q .number 2>/dev/null) || true
    PREVIEW_OWNER=$(gh repo view --json owner -q .owner.login) || true

    WORKFLOW=preview-deploy.yml
    UUID=$(uuidgen)

    gh workflow run --repo couchbase/docs-infra $WORKFLOW \
        --field preview_repo=${PREVIEW_REPO} \
        --field preview_branch=${PREVIEW_BRANCH} \
        --field preview_start_path=${PREVIEW_START_PATH} \
        --field preview_override=${PREVIEW_OVERRIDE} \
        --field pr_base_oid=${PR_BASE_OID} \
        --field preview_owner=${PREVIEW_OWNER} \
        --field pr_number=${PR_NUMBER} \
        --field uuid=${UUID} \
        --field preview_component=${PREVIEW_COMPONENT} \
        > /dev/null

    echo Requested the build at Github with UUID $UUID
    echo see https://github.com/couchbase/docs-infra/actions/workflows/preview-deploy.yml
    echo
    echo Visit 'https://preview.docs-test.couchbase.com/builds.html' to see all completed builds
    echo


    for i in {1..10}; do
        echo Polling github...
        URL=$(gh run list \
            --repo couchbase/docs-infra \
            -w $WORKFLOW \
            --json displayTitle,url,databaseId \
            | jq -r \
                --arg UUID $UUID \
                '.[] | select(.displayTitle | test($UUID))| .url' )
        if [ -n "$URL" ]; then
            success "Opening $URL in your web browser"
            # or could `gh run watch $databaseId`
            open $URL
            exit 0
        fi

        sleep 3
    done
    echo Timed out. Check Github actions
    exit 1

else
    export PREVIEW_GITHUB_REMOTE=$(git remote get-url origin 2>/dev/null)
    DOCS_SITE=$(realpath $0/../..)
    cd $DOCS_SITE
    echo

    if [ -n "$DEBUG" ]; then
        info "Running in debug mode"
        node scripts/preview-runner.js --debug || CODE=$?
        CODE=${CODE:-0}

        info "Opening preview/doctor - attach debug.log and these files if you're sending them to the docs team"
        open preview/doctor 2>/dev/null || true
        exit $CODE
    else
        node scripts/preview-runner.js
    fi
fi
